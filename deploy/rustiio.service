[Unit]
Description=Rustiio DLNA/UPnP media server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Korisnik/putanje postavlja `deploy/native/install.sh` (SERVICE_USER, PREFIX, STATE_DIR).
# Vrijednosti niže su samo sigurni defaulti za ručnu instalaciju.
User=rustiio
Group=rustiio
# Config (i kasnije baza) žive u /var/lib/rustiio — systemd ga stvori i vlasništvo prepusti korisniku.
StateDirectory=rustiio
Environment=RUSTIIO_CONFIG_DIR=/var/lib/rustiio
Environment=RUST_LOG=info
# Kljucevi (npr. TMDB_API_KEY) — drzi izvan repoa, mode 600.
EnvironmentFile=-/etc/rustiio/env
ExecStart=/usr/local/bin/rustiio run
# Health-check na razini systemd-a: ako /healthz ne vrati 200, restartaj.
ExecStartPost=/bin/sh -c 'sleep 2; /usr/local/bin/rustiio health --quiet'
# `always`, ne `on-failure`: restart iz sučelja (`POST /api/restart`) izlazi s 0,
# pa bi uz `on-failure` server ostao ugašen.
Restart=always
RestartSec=3

# Server ne piše ništa osim svog state direktorija; medije samo čita.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/rustiio
PrivateTmp=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
